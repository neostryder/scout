{
  "ingestTokenEnv": "SCOUT_FLEET_INGEST_TOKEN",
  "digestTimes": ["08:00", "18:00"],
  "policy": {
    "quietHours": { "start": "22:00", "end": "07:00", "timezone": "local" },
    "escalateAfterMinutes": 30,
    "escalateEveryMinutes": 120,
    "flapReopens": 3,
    "flapWindowMinutes": 60,
    "flapQuietMinutes": 60
  },
  "expected": [
    { "host": "desktop", "component": "backup", "everyMinutes": 1440, "graceMinutes": 30, "since": "2026-01-01T00:00:00.000Z" }
  ],
  "notifiers": [
    { "type": "desktop" },
    { "type": "webhook", "urlEnv": "SCOUT_FLEET_WEBHOOK_URL" },
    { "type": "command", "command": ["node", "-e", "process.stdin.resume()"] }
  ],
  "investigation": {
    "enabled": true,
    "analyst": { "command": ["node", "tools/fleet/investigation-analyst.mjs", "--", "your-model-command"] },
    "maxPerDay": 10,
    "maxRounds": 3,
    "maxCostUsdPerDay": 1,
    "timeoutSeconds": 240,
    "diagnostics": [
      { "id": "docker-ps", "machine": "server", "argv": ["docker", "ps", "-a"], "components": ["containers"], "failureClasses": ["dead"], "description": "List all containers with status" },
      { "id": "docker-logs", "machine": "server", "argv": ["docker", "logs", "--tail", "80", "{name}"], "params": { "name": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,100}$" }, "timeoutSeconds": 30 }
    ]
  }
}
